{
  "name": "@bitspark/archon-server",
  "version": "0.9.0",
  "description": "archon's service side: the login handler (four routes, law-free, store-minimal) and the request profile's verifier with its replay store. Fetch-style; opens no socket.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/archon.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@bitspark/archon": "file:../../core/ts",
    "@bitspark/archon-sdk": "file:../../sdk/ts"
  },
  "devDependencies": {
    "typescript": "^7.0",
    "@types/node": "^26"
  }
}
