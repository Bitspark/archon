cabal-version:      3.0
name:               archon-consumer
version:            0
synopsis:           An outside consumer of bitspark-archon-core
build-type:         Simple

-- This package has no cabal.project of its own ON PURPOSE. Whoever runs it writes one that says
-- where archon comes from, because that is the thing under test:
--
--   a local checkout (CI)       packages: . /path/to/archon/core/hs
--   the public tag (a stranger) source-repository-package
--                                 type:     git
--                                 location: https://github.com/Bitspark/archon.git
--                                 tag:      v0.8.0
--                                 subdir:   core/hs
executable consumer
    main-is:          Main.hs
    build-depends:
        base,
        bitspark-archon-core,
        bytestring,
        text
    default-language: Haskell2010
    ghc-options:      -Wall
